{
  "name": "grouppad",
  "version": "0.2.0",
  "description": "GroupPad — LA group trip rental aggregator with daily pipeline",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "pipeline": "node pipeline.js",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm ci && npm run build",
    "build": "npm run client:build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "playwright-core": "^1.60.0",
    "unpdf": "^1.8.1"
  }
}
